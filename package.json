{
  "name": "openclaw-max-messenger",
  "version": "0.5.0",
  "description": "OpenClaw channel plugin for Max Messenger (max.ru) — connect AI agents to Max via Bot API",
  "type": "module",
  "main": "./src/index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeyavdey/openclaw-max-messenger.git"
  },
  "keywords": [
    "openclaw",
    "max-messenger",
    "max.ru",
    "chatbot",
    "ai-agent",
    "channel-plugin"
  ],
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "setupEntry": "./src/setup-entry.ts",
    "channel": {
      "id": "max",
      "label": "Max Messenger",
      "selectionLabel": "Max Messenger (Bot API)",
      "docsPath": "/channels/max",
      "docsLabel": "max",
      "blurb": "Max Messenger bot integration via Bot API.",
      "order": 91,
      "aliases": [
        "max-messenger"
      ]
    },
    "install": {
      "localPath": "extensions/max",
      "defaultChoice": "local"
    },
    "compat": {
      "pluginApi": ">=2026.9.2",
      "minGatewayVersion": "2026.9.2"
    },
    "build": {
      "openclawVersion": "2026.9.2",
      "pluginSdkVersion": "2026.9.2"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@maxhub/max-bot-api": "^0.3.1"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "openclaw": "^2026.9.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "author": "alexonic",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  }
}
